<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pantry_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pantry_green_light</item>
        <item name="colorOnPrimaryContainer">@color/pantry_green_dark</item>
        <item name="colorSecondary">@color/pantry_green</item>
        <item name="colorSecondaryContainer">@color/pantry_green_light</item>
        <item name="colorOnSecondaryContainer">@color/pantry_green_dark</item>
        <item name="android:colorBackground">@color/screen_background</item>
    </style>
    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />
    <style name="PantryToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
    </style>
    <style name="SectionLabel">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">@dimen/spacing_l</item>
        <item name="android:layout_marginBottom">@dimen/spacing_s</item>
    </style>
</resources>